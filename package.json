{
  "name": "prism",
  "version": "0.3.4",
  "private": true,
  "description": "Prism: local-first, model-agnostic AI workspace that unites cowork, design, and science on macOS, Windows, and Linux.",
  "keywords": [
    "ai",
    "ai-agents",
    "ai-workspace",
    "local-first",
    "model-agnostic",
    "llm",
    "mcp",
    "jupyter",
    "notebooks",
    "reproducibility",
    "ai-for-science",
    "design-tools",
    "desktop-app",
    "tauri",
    "react",
    "typescript",
    "opencode"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @ai4s/desktop dev",
    "build": "pnpm --filter @ai4s/desktop build",
    "test": "pnpm --filter @ai4s/desktop test && pnpm --filter @ai4s/sdk test",
    "typecheck": "pnpm --filter @ai4s/desktop typecheck && pnpm --filter @ai4s/sdk typecheck",
    "lint": "pnpm --filter @ai4s/desktop lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.4.0"
}
